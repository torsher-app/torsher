{
  "projects": [
    {
      "path": "apps/server",
      "include": [
        "apps/tv-shell-webos",
        "apps/tv-shell-android",
        "engine",
        "Dockerfile",
        "docker"
      ]
    }
  ],
  "release": {
    "ignore": [],
    "changelog": {
      "projectChangelogs": true,
      "workspaceChangelog": false
    },
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "commitMessage": "chore(release): {tag}",
      "tagFormat": "v{version}"
    }
  }
}
