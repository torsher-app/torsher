{
  "name": "@torsher/server",
  "type": "module",
  "version": "1.2.0",
  "private": true,
  "bin": {
    "torsher": "src/cli.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/engineBuild.ts --optional && NODE_ENV=development node --env-file-if-exists=.env --watch src/main.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/main.ts",
    "openapi": "node scripts/openapi.ts",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "seed": "NODE_ENV=development node --env-file-if-exists=.env scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "engine:build": "node --env-file-if-exists=.env scripts/engineBuild.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@node-rs/argon2": "^2.2.2",
    "@torsher/i18n": "workspace:*",
    "@torsher/release-parser": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "10.0.16",
    "pino": "^10.4.0",
    "socks": "^2.8.10",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@torsher/tsconfig": "workspace:*",
    "@torsher/tv": "workspace:*",
    "@torsher/web": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
