API_PORT=3001
CLIENT_URL=http://localhost:3000
DATABASE_PATH=.data/torsher.db
SECRET_KEY=change-me-in-production
COOKIE_PREFIX=torsher

# API Read Access Token (v4): https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Коммит сборки и адрес исходников для экрана «О программе».
# Изменённая сборка обязана указать свой репозиторий (AGPL-3.0, раздел 13)
TORSHER_COMMIT=
TORSHER_SOURCE_URL=

# Дев-пользователь для `pnpm seed` (только вне production)
SEED_USER_EMAIL=dev@example.com
SEED_USER_PASSWORD=devpassword
