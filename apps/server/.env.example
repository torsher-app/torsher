API_PORT=3001
# Origin панели, если она открыта не с адреса сервера: ему открыт CORS с
# cookie. В production без явного значения не доверяется ни один чужой origin
CLIENT_URL=http://localhost:3000
DATABASE_PATH=.data/torsher.db
# Ключ подписи сессий. В production (NODE_ENV=production) сервер не стартует
# с этим значением и с ключом короче 32 символов: openssl rand -hex 32
SECRET_KEY=change-me-in-production
COOKIE_PREFIX=torsher

# За обратным прокси — его адрес или подсеть (через запятую; loopback,
# uniquelocal) или true. Без него ограничение попыток входа и журнал видят
# всех клиентов одним адресом прокси. Без прокси не задавайте: клиент
# подставит свой адрес в X-Forwarded-For
TRUST_PROXY=

# Ключ шифрования секретов в базе (API-ключи индексаторов). Если не задан,
# сервер создаёт файл secret.key (права 0600) рядом с базой. Потеря ключа
# делает сохранённые секреты нечитаемыми: их придётся ввести заново
TORSHER_SECRET=

# API Read Access Token (v4): https://www.themoviedb.org/settings/api.
# Без него и без ключа из панели каталог отвечает 503: ключ приложения
# есть только в опубликованном образе
TMDB_ACCESS_TOKEN=

# Если TMDB доступен только через HTTP(S)-прокси: Node берёт адрес
# из HTTPS_PROXY / HTTP_PROXY (исключения — NO_PROXY) только с этим флагом
# NODE_OPTIONS=--use-env-proxy

# Торрент-движок (torsher-app/engine, Go). `pnpm dev` собирает его при запуске,
# отдельно — `pnpm --filter @torsher/server engine:build`; нужен Go 1.24+.
# Без движка сервер работает, а раздачи и плеер отвечают 503.
# Готовый бинарник вместо сборки:
ENGINE_PATH=
# Порт для входящих соединений пиров; пусто — любой свободный
ENGINE_PEER_PORT=
# Куда движок пишет файлы раздач; по умолчанию downloads в каталоге данных
DOWNLOADS_PATH=

# ffmpeg и ffprobe для дорожек и перепаковки; по умолчанию — из PATH.
# Без них плеер играет файлы только напрямую
FFMPEG_PATH=
FFPROBE_PATH=

# 1 — обновлять базу, даже если копия перед миграциями не удалась.
# Без копии неудачное обновление не откатить
TORSHER_SKIP_PRE_UPDATE_BACKUP=

# Версия, коммит сборки и адрес исходников для экрана «О программе».
# Версию образ получает из тега релиза; с ней сервер проверяет обновления
# в релизах репозитория исходников. Изменённая сборка обязана указать свой
# репозиторий (AGPL-3.0, раздел 13)
TORSHER_VERSION=
TORSHER_COMMIT=
TORSHER_SOURCE_URL=

# Дев-пользователь для `pnpm seed` (только вне production)
SEED_USER_NAME=dev
SEED_USER_PASSWORD=devpassword
