<?xml version="1.0" encoding="utf-8"?>
<!--
  В резервные копии и перенос на другое устройство ничего не уходит: cookie
  WebView — сессия этого ТВ, на другом устройстве она была бы чужой.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
  </device-transfer>
</data-extraction-rules>
